{
    "redirects": [
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "candidatic.com.mx" }],
            "destination": "https://www.candidatic.com/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "www.candidatic.com.mx" }],
            "destination": "https://www.candidatic.com/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "candidatic.mx" }],
            "destination": "https://www.candidatic.com/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "www.candidatic.mx" }],
            "destination": "https://www.candidatic.com/$1",
            "permanent": true
        }
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/support",
            "destination": "/api/support"
        },
        {
            "source": "/privacy",
            "destination": "/api/public/privacy"
        },
        {
            "source": "/terms",
            "destination": "/api/public/terms"
        },
        {
            "source": "/s/:id",
            "destination": "/api/share?id=:id"
        },
        {
            "source": "/api/media/:id",
            "destination": "/api/image?id=:id"
        },
        {
            "source": "/api/tts/:text.mp3",
            "destination": "/api/ai/tts?text=:text"
        },
        {
            "source": "/lp/bolsadeempleo",
            "destination": "/api/lp/bolsadeempleo"
        }
    ],
    "headers": [
        {
            "source": "/api/image",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
                { "key": "Access-Control-Allow-Origin", "value": "*" }
            ]
        },
        {
            "source": "/api/bolsa-image",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
                { "key": "Access-Control-Allow-Origin", "value": "*" }
            ]
        },
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Credentials",
                    "value": "true"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Access-Control-Allow-Methods",
                    "value": "GET,POST,OPTIONS"
                },
                {
                    "key": "Access-Control-Allow-Headers",
                    "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"
                }
            ]
        }
    ],
    "functions": {
        "api/sse/candidates.js": {
            "maxDuration": 60
        },
        "api/ai/agent.js": {
            "maxDuration": 60
        },
        "api/cron/reengagement.js": {
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/cron/send-reminders",
            "schedule": "*/15 * * * *"
        },
        {
            "path": "/api/cron/reengagement",
            "schedule": "*/15 * * * *"
        }
    ]
}
